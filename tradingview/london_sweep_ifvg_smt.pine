//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  London Sweep + IFVG + SMT
//  1) Prise de liquidité du plus haut / plus bas de la session de Londres
//  2) SMT divergence sur pivots synchronisés (BSL / SSL) entre le graphique
//     (ex. NQ) et un symbole corrélé (ex. ES) :
//       - un niveau n'est retenu que s'il se forme sur la MÊME barre de
//         confirmation sur les deux symboles (aucune tolérance)
//       - SMT déclenchée quand EXACTEMENT UN des deux prend le niveau
//       - trailing en temps réel jusqu'à confirmation (nouveau pivot sur le
//         graphique dans le même sens), invalidation si les deux prennent le
//         niveau ou si le prix dépasse l'extrême parqué
//  3) Inversion Fair Value Gap (IFVG) : tracé UNIQUEMENT lorsqu'une SMT est
//     active (par défaut dans le même sens)
//  4) Tableau récapitulatif + alertes (filtrables par session)
//  Timeframe intraday requis.
// ─────────────────────────────────────────────────────────────────────────────
indicator("London Sweep + IFVG + SMT", shorttitle = "LDN·IFVG·SMT", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ═══════════════════════════════ ENTRÉES ═════════════════════════════════════
grpS      = "Session de Londres"
sessLdn   = input.session("0200-0500", "Session de Londres", group = grpS,
     tooltip = "Exprimée dans le fuseau ci-dessous. 02:00-05:00 New York = London killzone (ICT).\nPour la session complète : 0800-1630 avec le fuseau Europe/London.")
tz        = input.string("America/New_York", "Fuseau horaire", group = grpS,
     options = ["America/New_York", "Europe/London", "Europe/Paris", "UTC"])
sessSweep = input.session("0500-1600", "Fenêtre de prise de liquidité", group = grpS,
     tooltip = "Période (même fuseau) pendant laquelle une cassure du plus haut / plus bas de Londres compte comme prise de liquidité.")
sessNy    = input.session("0930-1600", "Session de New York", group = grpS,
     tooltip = "Même fuseau. Les IFVG et le premier retest IFVG après une SMT ne sont affichés que pendant cette session.")
showBg    = input.bool(true, "Colorer la session de Londres", group = grpS)
showLines = input.bool(true, "Tracer London High / London Low", group = grpS)

grpM      = "SMT (divergence Nasdaq / S&P 500)"
autoPair  = input.bool(true, "Symbole corrélé automatique", group = grpM,
     tooltip = "NQ/MNQ/NDX/US100 → CME_MINI:ES1!  |  ES/MES/SPX/US500 → CME_MINI:NQ1!\nSinon le symbole manuel ci-dessous est utilisé.")
manualSym = input.symbol("CME_MINI:ES1!", "Symbole corrélé (manuel)", group = grpM)
sensS     = input.string("Normal", "Sensibilité des pivots", options = ["Sensible", "Normal", "Strict"], group = grpM,
     tooltip = "Sensible = pivot 1 (beaucoup de swings mineurs)\nNormal = pivot 4 (équilibré)\nStrict = pivot 6 (swings majeurs uniquement)")
smtRealtime = input.bool(true, "SMT en temps réel (trailing)", group = grpM,
     tooltip = "Activé : la SMT est tracée dès la divergence et suit les nouveaux extrêmes jusqu'à confirmation.\nDésactivé : la SMT n'est tracée qu'une fois confirmée (parquée).")
maxSmt    = input.int(6, "Nombre max de SMT visibles", minval = 1, maxval = 50, group = grpM)
dedupe    = input.bool(true, "Dédoublonner (garder la SMT la plus récente)", group = grpM,
     tooltip = "Une nouvelle SMT dans le même sens remplace une SMT non confirmée existante.")
maxLvl    = input.int(20, "Niveaux synchronisés suivis (max)", minval = 5, maxval = 100, group = grpM)
lvlAge    = input.int(300, "Expiration d'un niveau (barres)", minval = 20, group = grpM)
showSmtLbl = input.bool(true, "Étiquette SMT à l'extrémité", group = grpM)
smtNeedConf = input.bool(false, "Exiger une SMT confirmée pour la confluence et les IFVG", group = grpM)
nySmtOnly   = input.bool(false, "Ne retenir que les SMT déclenchées pendant New York", group = grpM,
     tooltip = "Désactivé : une SMT déclenchée avant l'ouverture (ex. sur le London Low) peut autoriser un IFVG pendant New York.")

grpA      = "Style SMT"
smtBullCol = input.color(#26a69a, "SMT haussière : couleur", group = grpA)
smtBullW   = input.int(2, "SMT haussière : épaisseur", minval = 1, maxval = 3, group = grpA)
smtBullSt  = input.string("Plein", "SMT haussière : style", options = ["Plein", "Tirets", "Pointillés"], group = grpA)
smtBearCol = input.color(#ef5350, "SMT baissière : couleur", group = grpA)
smtBearW   = input.int(2, "SMT baissière : épaisseur", minval = 1, maxval = 3, group = grpA)
smtBearSt  = input.string("Plein", "SMT baissière : style", options = ["Plein", "Tirets", "Pointillés"], group = grpA)

grpF      = "Fair Value Gaps / IFVG"
ifvgMatch = input.bool(true, "IFVG dans le sens de la SMT uniquement", group = grpF,
     tooltip = "Activé : IFVG haussier tracé seulement si une SMT haussière est active (et inversement).\nDésactivé : n'importe quelle SMT active suffit.")
showFvg   = input.bool(false, "Afficher les FVG non inversés", group = grpF,
     tooltip = "Désactivé : seuls les IFVG sont dessinés. Les FVG restent suivis en arrière-plan.")
minFvgAtr = input.float(0.3, "Taille mini du FVG (× ATR 14)", minval = 0, step = 0.1, group = grpF)
maxFvg    = input.int(15, "Nombre max de FVG suivis", minval = 3, maxval = 100, group = grpF)
maxAge    = input.int(120, "Expiration d'un FVG non inversé (barres)", minval = 10, group = grpF)
ifvgAge   = input.int(120, "Expiration d'un IFVG (barres après inversion)", minval = 10, group = grpF)
farAtr    = input.float(8.0, "Figer les zones éloignées de plus de (× ATR 14)", minval = 0, step = 0.5, group = grpF,
     tooltip = "0 = désactivé. Une zone dont le milieu est à plus de N × ATR du prix cesse d'être prolongée.")
nyIfvgOnly = input.bool(true, "IFVG tracés uniquement pendant la session de New York", group = grpF)
showRetest = input.bool(true, "Marquer le 1er retest IFVG après une SMT (session New York)", group = grpF,
     tooltip = "Une seule étiquette « Retest IFVG » par SMT : le premier IFVG autorisé par cette SMT qui est retesté, pendant la session de New York.")
keepHist   = input.bool(true, "Conserver les zones terminées (historique)", group = grpF)

grpT      = "Tableau"
showTbl   = input.bool(true, "Afficher le tableau", group = grpT)
tblPosS   = input.string("Haut droite", "Position", group = grpT,
     options = ["Haut droite", "Haut gauche", "Bas droite", "Bas gauche", "Milieu droite"])
tblSizeS  = input.string("Petit", "Taille du texte", options = ["Très petit", "Petit", "Normal"], group = grpT)

grpAl     = "Alertes"
alertSessOn = input.bool(false, "Limiter les alertes à une session", group = grpAl)
alertSess   = input.session("0930-1600", "Session d'alerte (fuseau ci-dessus)", group = grpAl)

grpC      = "Couleurs"
colBull   = input.color(#26a69a, "Haussier", group = grpC)
colBear   = input.color(#ef5350, "Baissier", group = grpC)
colSess   = input.color(#2962ff, "Session de Londres", group = grpC)

pivLen = sensS == "Sensible" ? 1 : sensS == "Normal" ? 4 : 6

// ═══════════════════════════ SYMBOLE CORRÉLÉ ═════════════════════════════════
tickerUp = str.upper(syminfo.ticker)
isNasdaq = str.contains(tickerUp, "NQ") or str.contains(tickerUp, "NDX") or str.contains(tickerUp, "US100")
isSp500  = str.contains(tickerUp, "ES") or str.contains(tickerUp, "SPX") or str.contains(tickerUp, "US500")
corrSym  = autoPair ? (isNasdaq ? "CME_MINI:ES1!" : isSp500 ? "CME_MINI:NQ1!" : manualSym) : manualSym
corrParts = str.split(corrSym, ":")
corrName  = array.size(corrParts) > 0 ? array.get(corrParts, array.size(corrParts) - 1) : corrSym

// ═════════════ DONNÉES : SESSION DE LONDRES + PIVOTS (par symbole) ═══════════
// Appelée sur le graphique ET via request.security() pour le symbole corrélé.
f_data() =>
    bool inS = not na(time(timeframe.period, sessLdn, tz))
    var float h     = na
    var float l     = na
    var float hDone = na
    var float lDone = na
    if inS and not inS[1]
        h := high
        l := low
    else if inS
        h := math.max(nz(h, high), high)
        l := math.min(nz(l, low), low)
    if not inS and inS[1]
        hDone := h
        lDone := l
    float ph = ta.pivothigh(high, pivLen, pivLen)
    float pl = ta.pivotlow(low, pivLen, pivLen)
    [high, low, close, hDone, lDone, inS, ph, pl]

[_h, _l, _c, lonHi, lonLo, inS, ph, pl]          = f_data()
[cH, cL, cC, cLonHi, cLonLo, cInS, cPh, cPl]     = request.security(corrSym, timeframe.period, f_data())

sessStart = inS and not inS[1]
sessEnd   = not inS and inS[1]
atrVal    = ta.atr(14)

// ═══════════════════ SESSION DE LONDRES : ÉTATS ══════════════════════════════
var bool   lonDone       = false
var int    lonEndTime    = na
var bool   sweptLow      = false
var bool   sweptHigh     = false
var int    sweepLowBar   = na
var int    sweepHighBar  = na
var int    sweepLowTime  = na
var int    sweepHighTime = na
var bool   sweepLowRej   = false
var bool   sweepHighRej  = false
var line   lnHi          = na
var line   lnLo          = na

if sessStart
    lonDone       := false
    sweptLow      := false
    sweptHigh     := false
    sweepLowBar   := na
    sweepHighBar  := na
    sweepLowTime  := na
    sweepHighTime := na
    sweepLowRej   := false
    sweepHighRej  := false

if sessEnd and not na(lonHi) and not na(lonLo)
    lonDone    := true
    lonEndTime := time
    if showLines
        lnHi := line.new(bar_index, lonHi, bar_index + 1, lonHi, color = colBear, width = 1)
        lnLo := line.new(bar_index, lonLo, bar_index + 1, lonLo, color = colBull, width = 1)
        label.new(bar_index, lonHi, "London High", style = label.style_label_left, color = color.new(colBear, 100), textcolor = colBear, size = size.tiny)
        label.new(bar_index, lonLo, "London Low",  style = label.style_label_left, color = color.new(colBull, 100), textcolor = colBull, size = size.tiny)

inSweepWin = not na(time(timeframe.period, sessSweep, tz))
inNy       = not na(time(timeframe.period, sessNy, tz))
window     = lonDone and inSweepWin and not inS and not na(lonHi) and not na(lonLo)

newSweepLow  = window and not sweptLow  and low  < lonLo
newSweepHigh = window and not sweptHigh and high > lonHi

if newSweepLow
    sweptLow     := true
    sweepLowBar  := bar_index
    sweepLowTime := time
    sweepLowRej  := close > lonLo
    if not na(lnLo)
        line.set_x2(lnLo, bar_index)
        line.set_style(lnLo, line.style_dashed)
if newSweepHigh
    sweptHigh     := true
    sweepHighBar  := bar_index
    sweepHighTime := time
    sweepHighRej  := close < lonHi
    if not na(lnHi)
        line.set_x2(lnHi, bar_index)
        line.set_style(lnHi, line.style_dashed)

if lonDone and not inS
    if not na(lnHi) and not sweptHigh
        line.set_x2(lnHi, bar_index)
    if not na(lnLo) and not sweptLow
        line.set_x2(lnLo, bar_index)

// ═══════════════ SMT : NIVEAUX SYNCHRONISÉS (BSL / SSL) ══════════════════════
type Lvl
    bool  isHigh              // true = BSL (pivot haut), false = SSL (pivot bas)
    float p                   // niveau sur le graphique
    float cp                  // niveau sur le symbole corrélé
    int   bar                 // barre du pivot
    int   confBar             // barre de confirmation
    bool  chartSwept = false
    bool  corrSwept  = false
    bool  hasSmt     = false
    bool  done       = false

type Smt
    bool  isBull              // true = divergence SSL (haussière), false = BSL (baissière)
    Lvl   lvl
    bool  chartIsSweeper      // true = le graphique a pris le niveau, le corrélé l'a tenu
    int   trigBar
    int   endBar
    float endP
    bool  confirmed   = false
    bool  drawn       = false
    bool  nyTrig      = false      // déclenchée pendant la session de New York
    bool  retestShown = false      // le 1er retest IFVG a déjà été affiché pour cette SMT
    line  ln          = na
    label lb          = na

var array<Lvl> lvls = array.new<Lvl>()
var array<Smt> smts = array.new<Smt>()

f_lineStyle(string s) =>
    s == "Tirets" ? line.style_dashed : s == "Pointillés" ? line.style_dotted : line.style_solid

f_smtText(Smt s) =>
    string head = (s.isBull ? "SMT ▲ SSL" : "SMT ▼ BSL") + (s.confirmed ? " ✓" : " …")
    string who  = s.chartIsSweeper ? syminfo.ticker + " prend · " + corrName + " tient" : corrName + " prend · " + syminfo.ticker + " tient"
    head + "\n" + who

f_smtDraw(Smt s) =>
    color c  = s.isBull ? smtBullCol : smtBearCol
    int   w  = s.isBull ? smtBullW : smtBearW
    string st = f_lineStyle(s.isBull ? smtBullSt : smtBearSt)
    Lvl L = s.lvl
    s.ln := line.new(L.bar, L.p, s.endBar, s.endP, color = c, width = w, style = st)
    if showSmtLbl
        s.lb := label.new(s.endBar, s.endP, f_smtText(s),
             style = s.isBull ? label.style_label_up : label.style_label_down,
             color = color.new(c, 85), textcolor = c, size = size.tiny)
    s.drawn := true

f_smtUpdate(Smt s) =>
    if s.drawn
        line.set_xy2(s.ln, s.endBar, s.endP)
        if not na(s.lb)
            label.set_xy(s.lb, s.endBar, s.endP)
            label.set_text(s.lb, f_smtText(s))

f_smtDelete(Smt s) =>
    if not na(s.ln)
        line.delete(s.ln)
    if not na(s.lb)
        label.delete(s.lb)
    Lvl L = s.lvl
    L.done := true

bool newSmtBull  = false
bool newSmtBear  = false
bool confSmtBull = false
bool confSmtBear = false
bool invSmtBull  = false
bool invSmtBear  = false

// 1) Nouveaux niveaux synchronisés : pivot confirmé sur la MÊME barre sur les deux symboles
if not na(ph) and not na(cPh)
    array.push(lvls, Lvl.new(isHigh = true,  p = ph, cp = cPh, bar = bar_index - pivLen, confBar = bar_index))
if not na(pl) and not na(cPl)
    array.push(lvls, Lvl.new(isHigh = false, p = pl, cp = cPl, bar = bar_index - pivLen, confBar = bar_index))
while array.size(lvls) > maxLvl
    Lvl old = array.shift(lvls)
    old.done := true

// 2) Prises de niveau et déclenchement des SMT
if array.size(lvls) > 0
    for i = array.size(lvls) - 1 to 0
        Lvl L = array.get(lvls, i)
        bool drop = L.done
        if not drop and bar_index > L.confBar
            bool prevC = L.chartSwept
            bool prevK = L.corrSwept
            bool cs = L.isHigh ? high > L.p  : low < L.p
            bool ks = L.isHigh ? cH   > L.cp : cL  < L.cp
            if cs
                L.chartSwept := true
            if ks
                L.corrSwept := true
            if not L.hasSmt
                if L.chartSwept and L.corrSwept
                    // les deux ont pris le niveau : plus de divergence possible
                    drop := true
                else if (L.chartSwept or L.corrSwept) and not prevC and not prevK
                    // EXACTEMENT UN des deux prend le niveau → SMT
                    L.hasSmt := true
                    bool isBull = not L.isHigh
                    Smt s = Smt.new(isBull = isBull, lvl = L, chartIsSweeper = L.chartSwept,
                         trigBar = bar_index, endBar = bar_index, endP = isBull ? low : high, nyTrig = inNy)
                    if dedupe and array.size(smts) > 0
                        for j = array.size(smts) - 1 to 0
                            Smt o = array.get(smts, j)
                            if o.isBull == isBull and not o.confirmed
                                f_smtDelete(o)
                                array.remove(smts, j)
                    array.push(smts, s)
                    if smtRealtime
                        f_smtDraw(s)
                    if isBull
                        newSmtBull := true
                    else
                        newSmtBear := true
            if not drop and not L.hasSmt and bar_index - L.confBar > lvlAge
                drop := true
        if drop
            array.remove(lvls, i)

while array.size(smts) > maxSmt
    Smt old = array.shift(smts)
    f_smtDelete(old)

// 3) Suivi des SMT : trailing, confirmation (parquage), invalidation
if array.size(smts) > 0
    for i = array.size(smts) - 1 to 0
        Smt s = array.get(smts, i)
        Lvl L = s.lvl
        bool kill = false
        if L.chartSwept and L.corrSwept
            // les deux actifs ont pris le niveau → divergence disparue
            kill := true
        else if not s.confirmed
            // trailing sur l'extrême du graphique
            if s.isBull and low < s.endP
                s.endP   := low
                s.endBar := bar_index
            if not s.isBull and high > s.endP
                s.endP   := high
                s.endBar := bar_index
            // confirmation : nouveau pivot sur le graphique dans le même sens
            bool newPiv = s.isBull ? not na(pl) : not na(ph)
            if newPiv and bar_index - pivLen > L.bar and bar_index > s.trigBar
                s.confirmed := true
                float pivP = s.isBull ? pl : ph
                if (s.isBull and pivP <= s.endP) or (not s.isBull and pivP >= s.endP)
                    s.endP   := pivP
                    s.endBar := bar_index - pivLen
                if not s.drawn
                    f_smtDraw(s)
                if s.isBull
                    confSmtBull := true
                else
                    confSmtBear := true
            f_smtUpdate(s)
        else
            // parquée : invalidée si le prix dépasse l'extrême parqué
            if (s.isBull and low < s.endP) or (not s.isBull and high > s.endP)
                kill := true
        if kill
            if s.isBull
                invSmtBull := true
            else
                invSmtBear := true
            f_smtDelete(s)
            array.remove(smts, i)

// 4) État courant : dernière SMT valide dans chaque sens
Smt lastBullSmt = na
Smt lastBearSmt = na
Smt lastSmt     = na
if array.size(smts) > 0
    for i = 0 to array.size(smts) - 1
        Smt s = array.get(smts, i)
        bool ok = (s.confirmed or not smtNeedConf) and (not nySmtOnly or s.nyTrig)
        if ok
            if s.isBull
                lastBullSmt := s
            else
                lastBearSmt := s
    lastSmt := array.get(smts, array.size(smts) - 1)
bool smtBullActive = not na(lastBullSmt)
bool smtBearActive = not na(lastBearSmt)

// ═══════════════════════ FVG / INVERSION FVG ═════════════════════════════════
type Fvg
    box   bx
    float top
    float bot
    bool  bullOrig
    bool  inverted = false
    bool  retested = false
    int   born
    int   invBar   = na
    Smt   smt      = na       // SMT qui a autorisé l'inversion

var array<Fvg> fvgs = array.new<Fvg>()
var int   ifvgBullBar = na
var int   ifvgBearBar = na
var float lastIfvgTop = na
var float lastIfvgBot = na
var int   lastIfvgDir = 0

// Zone terminée : figée à la barre courante et atténuée (ou supprimée si invisible / historique désactivé)
f_finish(Fvg f) =>
    bool visible = f.inverted or showFvg
    if visible and keepHist
        box.set_right(f.bx, bar_index)
        color base = f.inverted ? (f.bullOrig ? colBear : colBull) : (f.bullOrig ? colBull : colBear)
        box.set_bgcolor(f.bx, color.new(base, 90))
        box.set_border_color(f.bx, color.new(base, 65))
        box.set_text_color(f.bx, color.new(base, 50))
    else
        box.delete(f.bx)

f_invert(Fvg f, bool toBull) =>
    color c = toBull ? colBull : colBear
    f.inverted := true
    f.invBar   := bar_index
    box.set_bgcolor(f.bx, color.new(c, 65))
    box.set_border_color(f.bx, color.new(c, 20))
    box.set_border_style(f.bx, line.style_solid)
    box.set_text(f.bx, toBull ? "IFVG ▲" : "IFVG ▼")
    box.set_text_color(f.bx, c)
    box.set_text_size(f.bx, size.tiny)
    box.set_text_halign(f.bx, text.align_right)
    box.set_text_valign(f.bx, toBull ? text.align_bottom : text.align_top)

bool ifvgBullEvent  = false
bool ifvgBearEvent  = false
bool ifvgBullRetest = false
bool ifvgBearRetest = false

// Un FVG n'est validé en IFVG que si une SMT encore valide a été déclenchée
//   - ENTRE la création du FVG (barre born) et la barre d'inversion (barre courante)
//   - pendant la session de New York
//   - dans le même sens que l'IFVG (si demandé)
f_authSmt(bool wantBull, int born) =>
    Smt res = na
    if array.size(smts) > 0
        for i = 0 to array.size(smts) - 1
            Smt s = array.get(smts, i)
            bool dirOk = ifvgMatch ? s.isBull == wantBull : true
            bool ok = dirOk and s.nyTrig and (s.confirmed or not smtNeedConf) and s.trigBar >= born and s.trigBar <= bar_index
            if ok
                res := s
    res

if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        Fvg f = array.get(fvgs, i)
        bool drop = false
        bool tooFar = farAtr > 0 and math.abs(close - (f.top + f.bot) / 2) > farAtr * atrVal
        if tooFar
            drop := true
        else if not f.inverted
            if bar_index - f.born > maxAge
                drop := true
            else if f.bullOrig and close < f.bot
                // FVG haussier clôturé en dessous → IFVG baissier (résistance)
                Smt A = na
                if not nyIfvgOnly or inNy
                    A := f_authSmt(false, f.born)
                if not na(A)
                    f_invert(f, false)
                    f.smt := A
                    ifvgBearEvent := true
                    ifvgBearBar   := bar_index
                    lastIfvgTop   := f.top
                    lastIfvgBot   := f.bot
                    lastIfvgDir   := -1
                else
                    box.delete(f.bx)
                    array.remove(fvgs, i)
                    continue
            else if not f.bullOrig and close > f.top
                // FVG baissier clôturé au-dessus → IFVG haussier (support)
                Smt A = na
                if not nyIfvgOnly or inNy
                    A := f_authSmt(true, f.born)
                if not na(A)
                    f_invert(f, true)
                    f.smt := A
                    ifvgBullEvent := true
                    ifvgBullBar   := bar_index
                    lastIfvgTop   := f.top
                    lastIfvgBot   := f.bot
                    lastIfvgDir   := 1
                else
                    box.delete(f.bx)
                    array.remove(fvgs, i)
                    continue
        else if bar_index - f.invBar > ifvgAge
            drop := true
        else
            if not f.bullOrig
                if close < f.bot
                    drop := true
                else if not f.retested and bar_index > f.invBar and low <= f.top
                    f.retested := true
                    Smt S = f.smt
                    if inNy and not na(S) and not S.retestShown
                        S.retestShown  := true
                        ifvgBullRetest := true
            else
                if close > f.top
                    drop := true
                else if not f.retested and bar_index > f.invBar and high >= f.bot
                    f.retested := true
                    Smt S = f.smt
                    if inNy and not na(S) and not S.retestShown
                        S.retestShown  := true
                        ifvgBearRetest := true
        if drop
            f_finish(f)
            array.remove(fvgs, i)
        else
            box.set_right(f.bx, bar_index)

minSize = atrVal * minFvgAtr
bullFvg = low > high[2] and (low - high[2]) >= minSize
bearFvg = high < low[2] and (low[2] - high) >= minSize

f_newFvg(bool isBull, float fTop, float fBot) =>
    color base = isBull ? colBull : colBear
    int   tr   = showFvg ? 0 : 100
    box b = box.new(bar_index - 1, fTop, bar_index, fBot, xloc = xloc.bar_index,
         border_color = color.new(base, math.max(60, tr)), border_style = line.style_dotted,
         bgcolor = color.new(base, math.max(86, tr)))
    array.push(fvgs, Fvg.new(bx = b, top = fTop, bot = fBot, bullOrig = isBull, born = bar_index))

if bullFvg
    f_newFvg(true, low, high[2])
if bearFvg
    f_newFvg(false, low[2], high)

while array.size(fvgs) > maxFvg
    Fvg old = array.shift(fvgs)
    f_finish(old)

// ═══════════════════════════ CONFLUENCE ══════════════════════════════════════
ifvgBullOk = sweptLow  and not na(ifvgBullBar) and ifvgBullBar >= sweepLowBar
ifvgBearOk = sweptHigh and not na(ifvgBearBar) and ifvgBearBar >= sweepHighBar

bullScore = (sweptLow  ? 1 : 0) + (smtBullActive ? 1 : 0) + (ifvgBullOk ? 1 : 0)
bearScore = (sweptHigh ? 1 : 0) + (smtBearActive ? 1 : 0) + (ifvgBearOk ? 1 : 0)
setupBull = bullScore == 3
setupBear = bearScore == 3
setupBullNew = setupBull and not setupBull[1]
setupBearNew = setupBear and not setupBear[1]

// ═══════════════════════════ AFFICHAGE ═══════════════════════════════════════
bgcolor(showBg and inS ? color.new(colSess, 88) : na)

string txtBelow = ""
string txtAbove = ""
if newSweepLow
    txtBelow += "Sweep London Low" + (sweepLowRej ? " (rejet)" : "")
if ifvgBullRetest and showRetest
    txtBelow += (txtBelow != "" ? "\n" : "") + "1er retest IFVG ▲"
if setupBullNew
    txtBelow += (txtBelow != "" ? "\n" : "") + "SETUP HAUSSIER 3/3"
if newSweepHigh
    txtAbove += "Sweep London High" + (sweepHighRej ? " (rejet)" : "")
if ifvgBearRetest and showRetest
    txtAbove += (txtAbove != "" ? "\n" : "") + "1er retest IFVG ▼"
if setupBearNew
    txtAbove += (txtAbove != "" ? "\n" : "") + "SETUP BAISSIER 3/3"

if txtBelow != ""
    label.new(bar_index, na, txtBelow, yloc = yloc.belowbar, style = label.style_label_up,
         color = color.new(colBull, 15), textcolor = color.white, size = size.tiny)
if txtAbove != ""
    label.new(bar_index, na, txtAbove, yloc = yloc.abovebar, style = label.style_label_down,
         color = color.new(colBear, 15), textcolor = color.white, size = size.tiny)

// ═══════════════════════════ TABLEAU ═════════════════════════════════════════
tblPos  = tblPosS == "Haut droite" ? position.top_right : tblPosS == "Haut gauche" ? position.top_left :
     tblPosS == "Bas droite" ? position.bottom_right : tblPosS == "Bas gauche" ? position.bottom_left : position.middle_right
txtSize = tblSizeS == "Très petit" ? size.tiny : tblSizeS == "Petit" ? size.small : size.normal

var table t = table.new(tblPos, 2, 11, bgcolor = color.new(#131722, 10),
     frame_color = color.new(color.gray, 40), frame_width = 1,
     border_color = color.new(color.gray, 70), border_width = 1)
var bool tblMerged = false

f_row(int r, string k, string v, color vc) =>
    table.cell(t, 0, r, k, text_color = color.new(color.white, 25), text_halign = text.align_left,  text_size = txtSize)
    table.cell(t, 1, r, v, text_color = vc,                          text_halign = text.align_right, text_size = txtSize)

f_price(float p) => na(p) ? "—" : str.tostring(p, format.mintick)

if showTbl and barstate.islast
    table.cell(t, 0, 0, "London Sweep · IFVG · SMT\n" + syminfo.ticker + "  vs  " + corrName + "  ·  pivot " + str.tostring(pivLen),
         text_color = color.white, bgcolor = color.new(colSess, 55), text_size = txtSize)
    if not tblMerged
        table.merge_cells(t, 0, 0, 1, 0)
        tblMerged := true

    sessTxt = inS ? "En cours" : lonDone ? "Terminée à " + str.format_time(lonEndTime, "HH:mm", tz) : "En attente"
    sessCol = inS ? colSess : color.white
    hiTxt = f_price(lonHi) + (sweptHigh ? "  ✓ pris" : "")
    loTxt = f_price(lonLo) + (sweptLow  ? "  ✓ pris" : "")
    liqTxt = sweptLow and sweptHigh ? "Low et High pris" :
         sweptLow  ? "Low à "  + str.format_time(sweepLowTime,  "HH:mm", tz) + (sweepLowRej  ? " (rejet)" : "") :
         sweptHigh ? "High à " + str.format_time(sweepHighTime, "HH:mm", tz) + (sweepHighRej ? " (rejet)" : "") : "Aucune"
    liqCol = sweptLow and not sweptHigh ? colBull : sweptHigh and not sweptLow ? colBear : color.white

    string smtTxt = "Aucune"
    color  smtCol = color.white
    if not na(lastSmt)
        Lvl L = lastSmt.lvl
        smtTxt := (lastSmt.isBull ? "Haussière (SSL) " : "Baissière (BSL) ") + (lastSmt.confirmed ? "confirmée" : "temps réel") +
             " · " + (lastSmt.chartIsSweeper ? syminfo.ticker + " prend, " + corrName + " tient" : corrName + " prend, " + syminfo.ticker + " tient") +
             " · niveau " + f_price(L.p)
        smtCol := lastSmt.isBull ? colBull : colBear
    nbBull = 0
    nbBear = 0
    if array.size(smts) > 0
        for i = 0 to array.size(smts) - 1
            Smt s = array.get(smts, i)
            if s.isBull
                nbBull += 1
            else
                nbBear += 1
    lvlTxt = str.tostring(array.size(lvls)) + " niveaux · SMT actives ▲" + str.tostring(nbBull) + " ▼" + str.tostring(nbBear)

    ifvgTxt = lastIfvgDir == 0 ? "—" : (lastIfvgDir > 0 ? "Haussier ▲  " : "Baissier ▼  ") + f_price(lastIfvgBot) + " – " + f_price(lastIfvgTop)
    ifvgCol = lastIfvgDir > 0 ? colBull : lastIfvgDir < 0 ? colBear : color.white
    bullTxt = str.tostring(bullScore) + "/3   " + (sweptLow  ? "Sweep ✓" : "Sweep ✗") + "  " + (smtBullActive ? "SMT ✓" : "SMT ✗") + "  " + (ifvgBullOk ? "IFVG ✓" : "IFVG ✗")
    bearTxt = str.tostring(bearScore) + "/3   " + (sweptHigh ? "Sweep ✓" : "Sweep ✗") + "  " + (smtBearActive ? "SMT ✓" : "SMT ✗") + "  " + (ifvgBearOk ? "IFVG ✓" : "IFVG ✗")
    statusTxt = timeframe.isdwm ? "⚠ Timeframe intraday requis" : setupBull ? "SETUP HAUSSIER 3/3" : setupBear ? "SETUP BAISSIER 3/3" : "En attente"
    statusCol = timeframe.isdwm ? color.orange : setupBull ? colBull : setupBear ? colBear : color.white

    f_row(1,  "Session Londres",   sessTxt,   sessCol)
    f_row(2,  "London High",       hiTxt,     sweptHigh ? colBear : color.white)
    f_row(3,  "London Low",        loTxt,     sweptLow  ? colBull : color.white)
    f_row(4,  "Liquidité prise",   liqTxt,    liqCol)
    f_row(5,  "SMT vs " + corrName, smtTxt,   smtCol)
    f_row(6,  "Niveaux sync.",     lvlTxt,    color.white)
    f_row(7,  "Dernier IFVG",      ifvgTxt,   ifvgCol)
    f_row(8,  "Confluence ▲",      bullTxt,   bullScore == 3 ? colBull : color.white)
    f_row(9,  "Confluence ▼",      bearTxt,   bearScore == 3 ? colBear : color.white)
    f_row(10, "Statut",            statusTxt, statusCol)

// ═══════════════════════════ ALERTES ═════════════════════════════════════════
alertOn = not alertSessOn or not na(time(timeframe.period, alertSess, tz))

alertcondition(alertOn and newSweepLow,    "London Low pris",         "London Low pris sur {{ticker}} ({{interval}})")
alertcondition(alertOn and newSweepHigh,   "London High pris",        "London High pris sur {{ticker}} ({{interval}})")
alertcondition(alertOn and newSmtBull,     "SMT haussière détectée",  "SMT haussière (SSL) sur {{ticker}} ({{interval}})")
alertcondition(alertOn and newSmtBear,     "SMT baissière détectée",  "SMT baissière (BSL) sur {{ticker}} ({{interval}})")
alertcondition(alertOn and confSmtBull,    "SMT haussière confirmée", "SMT haussière confirmée (parquée) sur {{ticker}} ({{interval}})")
alertcondition(alertOn and confSmtBear,    "SMT baissière confirmée", "SMT baissière confirmée (parquée) sur {{ticker}} ({{interval}})")
alertcondition(alertOn and (invSmtBull or invSmtBear), "SMT invalidée", "SMT invalidée sur {{ticker}} ({{interval}})")
alertcondition(alertOn and ifvgBullEvent,  "IFVG haussier formé",     "IFVG haussier (avec SMT) sur {{ticker}} ({{interval}})")
alertcondition(alertOn and ifvgBearEvent,  "IFVG baissier formé",     "IFVG baissier (avec SMT) sur {{ticker}} ({{interval}})")
alertcondition(alertOn and ifvgBullRetest, "1er retest IFVG haussier", "1er retest IFVG haussier après SMT sur {{ticker}} ({{interval}})")
alertcondition(alertOn and ifvgBearRetest, "1er retest IFVG baissier", "1er retest IFVG baissier après SMT sur {{ticker}} ({{interval}})")
alertcondition(alertOn and setupBullNew,   "Setup haussier complet",  "Sweep + SMT + IFVG haussiers sur {{ticker}} ({{interval}})")
alertcondition(alertOn and setupBearNew,   "Setup baissier complet",  "Sweep + SMT + IFVG baissiers sur {{ticker}} ({{interval}})")
